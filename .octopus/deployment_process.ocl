step "verifier-sante-post-deploiement" {
    condition = "Success"
    name = "Vérifier la santé des services post-déploiement"

    action {
        action_type = "Octopus.Script"
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -e
                NAMESPACE="elara-#{Octopus.Environment.Name | ToLower}"
                echo "Namespace ciblé : \${NAMESPACE}"

                # Attente jusqu'à disponibilité des 3 déploiements (rollout terminé)
                for deploy in elara-api-nest-api-nest elara-api-ai-api-ai elara-web-web; do
                    echo "==> Attente du rollout de \${deploy} (délai max 5 min)"
                    kubectl rollout status deployment/\${deploy} -n "\${NAMESPACE}" --timeout=300s
                done

                # Healthchecks HTTP finaux (hors cluster via port-forward si besoin)
                echo "==> Vérification /v1/health api-nest"
                if kubectl -n "\${NAMESPACE}" port-forward svc/elara-api-nest-api-nest 3001:80 &
                then
                    sleep 3
                    curl -fsS http://127.0.0.1:3001/v1/health && echo "api-nest OK"
                fi

                echo "==> Vérification /health api-ai"
                if kubectl -n "\${NAMESPACE}" port-forward svc/elara-api-ai-api-ai 8000:80 &
                then
                    sleep 3
                    curl -fsS http://127.0.0.1:8000/health && echo "api-ai OK"
                fi
            EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool = "hosted-windows"
    }
}

step "validation-humaine-avant-production" {
    condition = "Success"
    name = "Validation humaine obligatoire (production)"

    action {
        action_type = "Octopus.ManualIntervention"
        environments = ["production"]
        is_required = true
        properties = {
            Octopus.Action.ManualIntervention.Instructions = "Aucune promotion vers production n'est automatique. Vérifiez que staging a été recetté (Partie 21) avant d'autoriser ce déploiement."
            Octopus.Action.ManualIntervention.ResponsibleTeam = "ElaraReleaseManagers"
        }
    }
}