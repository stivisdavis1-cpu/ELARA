step "migrer-schema-postgresql" {
    name = "Migrer la base de données PostgreSQL (schema + RLS + pgvector)"
    properties = {
        Octopus.Action.RunOnServer = "false"
    }

    action {
        action_type = "Octopus.Script"
        is_required = true
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                set -e
                # Applique les migrations SQL versionnées dans Infra en ordre alphabétique.
                # Variable sensible Elara.Database.ConnectionString fournie par Octopus
                # (jamais commitée) : postgresql://user:pass@host:5432/db
                echo "Nombre de fichiers de migration : \$(ls -1 infra/db/migrations/*.sql | wc -l)"
                for migration in \$(ls -1 infra/db/migrations/*.sql | sort); do
                    echo "==> Application de \${migration}"
                    psql "#{Elara.Database.ConnectionString}" -v ON_ERROR_STOP=1 -f "\${migration}"
                done
                echo "Migrations PostgreSQL appliquées avec succès."
            EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
        }
        worker_pool = "hosted-windows"
    }
}

step "deployer-api-nest-helm" {
    condition = "Success"
    name = "Déployer api-nest via Helm"

    action {
        action_type = "Octopus.HelmChartUpgrade"
        is_required = true
        properties = {
            Octopus.Action.Helm.ChartSource = "ProjectGitRepository"
            Octopus.Action.Helm.ChartDirectory = "infra/k8s/api-nest"
            Octopus.Action.Helm.ReleaseName = "elara-api-nest"
            Octopus.Action.Helm.ResetValues = "True"
            Octopus.Action.Helm.Timeout = "600"
            Octopus.Action.Helm.AdditionalArgs = "-f infra/k8s/api-nest/values-#{Elara.ValuesEnv}.yaml --atomic --install --timeout=600s"
        }
    }
}

