# ============================================================
# ELARA — variables d'environnement (développement local)
# ============================================================
# Copier vers `.env` (NON versionné, jamais commité) :
#   cp .env.example .env
# Puis renseigner chaque mot de passe (générés, uniques, 16+ caractères).
# Sans ces variables, `docker compose up` ÉCHOUE explicitement plutôt que
# de démarrer avec des secrets par défaut attaquables en 1 seconde.
# ============================================================

# --- Postgres ---
POSTGRES_USER=elara
POSTGRES_PASSWORD=CHANGER-MOI-postgres-16-caracteres-min
POSTGRES_DB=elara

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGER-MOI-keycloak-admin
# Mode Keycloak : start-dev (local, HTTP) | start (production, TLS requis)
KEYCLOAK_START_COMMAND=start-dev
# Secret du client elara-web + mot de passe initial des comptes seed (dev).
KEYCLOAK_CLIENT_SECRET=CHANGER-MOI-keycloak-client-secret
SEED_USER_PASSWORD=CHANGER-MOI-seed-user

# --- MinIO (8 caractères minimum imposés par MinIO) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGER-MOI-minio-8-min

# --- NextAuth (sessions web) : 32+ caractères aléatoires ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET=CHANGER-MOI-auth-secret-32-caracteres-minimum
KEYCLOAK_CLIENT_ID=elara-web
KEYCLOAK_CLIENT_SECRET=CHANGER-MOI-keycloak-client-secret

# --- URLs publiques ---
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- API NestJS ---
PORT=3001
REDIS_URL=redis://localhost:6379
# Doc API hors-prod : jeton exigé sur /docs (header x-docs-token ou ?token=).
# Vide = /docs ouvert en dev local uniquement ; TOUJOURS renseigné en staging.
DOCS_TOKEN=
