KEYCLOAK_URL=http://localhost:8080
# Le realm est `Elara` (E majuscule) et l'émetteur vu par les conteneurs est
# `keycloak:8080`. Sans ces deux valeurs, JwtStrategy retombe sur
# `http://localhost:8080/realms/elara` : ni l'émetteur ni le jeu de clés JWKS
# ne correspondent à ce que le web distribue, et la vérification du jeton échoue.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/Elara
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/Elara/protocol/openid-connect/certs
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
API_AI_INTERNAL_URL=http://localhost:8000
MINIO_ACCESS_KEY=admin
