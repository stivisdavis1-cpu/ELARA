generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum RoleUtilisateur {
  admin_compte
  utilisateur_standard
  assistant_ia_systeme
  integration_externe
}

enum StatutFacture {
  brouillon
  envoyee
  payee
  impayee
  annulee
}

enum StatutCommande {
  brouillon
  validee
  livree
  annulee
}

enum SystemeComptable {
  SYSCOHADA
  PCG
  IFRS
  AUTRE
}

model Tenant {
  id                String           @id @default(uuid())
  raison_sociale    String
  secteur           String?
  pays              String?
  ville             String?
  devise            String?
  statut_abonnement String?
  systeme_comptable SystemeComptable @default(SYSCOHADA)
  parametres        Json?            @default("{}")
  created_at        DateTime         @default(now())

    users              User[]
    user_tenants       UserTenant[]
    invitations        Invitation[]
  clients            Client[]
  fournisseurs       Fournisseur[]
  factures           Facture[]
  documents          Document[]
  document_elements  DocumentElement[]
  produits           Produit[]
  commandes          Commande[]
  paiements          Paiement[]
  depenses           Depense[]
  tax_rules          TaxRule[]
  conversations      Conversation[]
  company_memories   CompanyMemory[]
  document_templates DocumentTemplate[]
  documents_generes  DocumentGenere[]
  workflows          Workflow[]
  validations        Validation[]
  integrations       Integration[]
  employes           Employe[]

  @@map("tenants")
}

model User {
  id                  String          @id @default(uuid())
  tenant_id           String
  nom                 String
  email               String          @unique
  role                RoleUtilisateur
  keycloak_subject_id String?         @unique

  // NULL tant que l'invité n'a pas choisi son mot de passe. Cette colonne
  // est la seule preuve exploitable : Keycloak ne renvoie pas les
  // identifiants d'un utilisateur, donc l'API ne peut pas savoir par elle-même
  // si une identité a déjà un mot de passe.
  mot_de_passe_defini_le DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

    tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
    user_tenants UserTenant[]
    invitations  Invitation[]
  
    @@map("users")
  }
  
  // Lien d'activation d'un compte invité.
  //
  // Le jeton n'est conservé que sous forme d'empreinte : la base ne permet pas
  // de mettre un compte en danger à elle seule. Une invitation est à usage
  // unique et expirable — c'est ce qui permet à l'invité de choisir son mot de
  // passe, l'administrateur ne le connaissant jamais.
  model Invitation {
    id         String   @id @default(uuid())
    tenant_id  String
    user_id    String?
    email      String
    role       RoleUtilisateur @default(utilisateur_standard)
    jeton_hash String   @unique
    expire_le  DateTime
    utilise_le DateTime?
    invite_par String?
    created_at DateTime @default(now())
  
    tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
    user   User?  @relation(fields: [user_id], references: [id], onDelete: SetNull)
  
    @@index([email])
    @@index([expire_le])
    @@map("invitations")
  }

model UserTenant {
  user_id   String
  tenant_id String
  role      RoleUtilisateur

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@id([user_id, tenant_id])
  @@map("user_tenants")
}

model Client {
  id                 String  @id @default(uuid())
  tenant_id          String
  nom                String
  email              String?
  telephone          String?
  adresse            String?
  identifiant_fiscal String?
  niu                String?
  rccm               String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant    Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  factures  Facture[]
  commandes Commande[]
  paiements Paiement[]

  @@map("clients")
}

model Fournisseur {
  id                 String  @id @default(uuid())
  tenant_id          String
  nom                String
  email              String?
  telephone          String?
  adresse            String?
  identifiant_fiscal String?
  niu                String?
  rccm               String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant    Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  factures  Facture[]
  commandes Commande[]
  depenses  Depense[]

  @@map("fournisseurs")
}

model Produit {
  id            String  @id @default(uuid())
  tenant_id     String
  nom           String
  reference     String?
  description   String?
  prix_unitaire Decimal @db.Decimal(10, 2)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  stocks Stock[]

  @@map("produits")
}

model Stock {
  id         String  @id @default(uuid())
  produit_id String
  quantite   Int     @default(0)
  entrepot   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  produit Produit @relation(fields: [produit_id], references: [id], onDelete: Cascade)

  @@map("stocks")
}

model Commande {
  id             String         @id @default(uuid())
  tenant_id      String
  client_id      String?
  fournisseur_id String?
  numero         String?
  document_id    String?
  statut         StatutCommande @default(brouillon)
  montant_total  Decimal        @db.Decimal(10, 2)
  date_commande  DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [client_id], references: [id])
  fournisseur Fournisseur? @relation(fields: [fournisseur_id], references: [id])
  document    Document?    @relation(fields: [document_id], references: [id])
  factures    Facture[]

  @@map("commandes")
}

model Facture {
  id             String        @id @default(uuid())
  tenant_id      String
  client_id      String?
  fournisseur_id String?
  commande_id    String?
  numero         String?
  document_id    String?
  categorie      String?
  montant_ht     Decimal?      @db.Decimal(10, 2)
  taux_tva       Decimal?      @db.Decimal(5, 2)
  montant_tva    Decimal?      @db.Decimal(10, 2)
  montant_total  Decimal       @db.Decimal(10, 2)
  statut         StatutFacture @default(brouillon)
  date_emission  DateTime?
  date_echeance  DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [client_id], references: [id])
  fournisseur Fournisseur? @relation(fields: [fournisseur_id], references: [id])
  commande    Commande?    @relation(fields: [commande_id], references: [id])
  document    Document?    @relation(fields: [document_id], references: [id])
  paiements   Paiement[]

  @@map("factures")
}

model Paiement {
  id            String   @id @default(uuid())
  tenant_id     String
  client_id     String?
  facture_id    String?
  document_id   String?
  reference     String?
  montant       Decimal  @db.Decimal(10, 2)
  date_paiement DateTime @default(now())
  mode_paiement String? // Ex: virement, CB, ch�que

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [client_id], references: [id])
  facture  Facture?  @relation(fields: [facture_id], references: [id])
  document Document? @relation(fields: [document_id], references: [id], onDelete: SetNull)

  // Un relevé bancaire réimporté ne doit pas compter deux fois en trésorerie.
  // La référence de l'opération identifie le mouvement à l'intérieur du relevé.
  @@unique([tenant_id, document_id, reference])
  @@index([tenant_id, date_paiement])

  @@map("paiements")
}

model Depense {
  id             String   @id @default(uuid())
  tenant_id      String
  fournisseur_id String?
  document_id    String?
  montant        Decimal  @db.Decimal(10, 2)
  categorie      String?
  date_depense   DateTime @default(now())
  description    String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  fournisseur Fournisseur? @relation(fields: [fournisseur_id], references: [id])
  document    Document?    @relation(fields: [document_id], references: [id])

  @@map("depenses")
}

model Document {
  id                String  @id @default(uuid())
  tenant_id         String
  lien_minio        String
  type_document     String?
  score_confiance   Float?
  niveau_risque     Int?    @default(0)
  statut_validation String?
  hash_document     String?

  // Archive GED (diskgroup sécurisé + index logique) — champ ajouté via
  // ALTER TABLE idempotent sur la BDD (Supabase), lu via requêtes SQL brutes.
  archive_path     String?
  archive_checksum String?
  archive_size     Int?
  archived_at      DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  factures          Facture[]
  depenses          Depense[]
  paiements         Paiement[]
  commandes         Commande[]
  chunks            DocumentChunk[]
  documents_generes DocumentGenere[]
  elements          DocumentElement[]

  @@unique([tenant_id, hash_document])
  @@map("documents")
}

/// Un élément d'information extrait d'un document, avec sa nature.
/// L'extraction plate (`extraction_data`) ne disait pas ce qu'était une valeur :
/// un mot-clé d'indexation se retrouvait indiscernable d'un montant. Chaque
/// élément est donc typé, et porte sa provenance pour qu'on puisse distinguer
/// ce que l'IA a proposé de ce qu'un humain a corrigé.
model DocumentElement {
  id          String   @id @default(uuid())
  tenant_id   String
  document_id String

  /// mot_cle | acteur | date | montant | reference | texte | autre
  nature      String   @default("autre")
  label       String
  valeur      String
  /// Page et rectangle (0-1) de la zone OCR d'origine, si l'élément vient d'une zone
  page        Int?
  zone        Json?
  /// Score de confiance de l'extraction automatique, 0 à 1
  confiance   Float?
  /// valide | a_valider — la validation automatique ne vaut que si la
  /// confiance dépasse le seuil de l'entreprise ; en dessous, l'élément part
  /// en revue humaine. Une correction manuelle force le statut.
  statut      String   @default("a_valider")
  /// ocr | ia | manuel
  source      String   @default("ia")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, document_id])
  @@map("document_elements")
}

model DocumentChunk {
  id          String                      @id @default(uuid())
  document_id String
  page_number Int
  content     String
  embedding   Unsupported("vector(768)")?

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id])
  @@map("document_chunks")
}

// L'historique des modifications alimenté par trigger SQL
model HistoriqueModifications {
  id         String   @id @default(uuid())
  table_name String
  record_id  String
  action     String
  old_data   Json?
  new_data   Json?
  changed_at DateTime @default(now())
  changed_by String?

  @@map("historique_modifications")
}

// Audit trail indépendant
model AuditTrail {
  id               String   @id @default(uuid())
  tenant_id        String
  acteur_type      String // utilisateur, systeme_ia, integration
  acteur_id        String
  action           String
  entite_concernee String
  statut           String
  metadata         Json?
  created_at       DateTime @default(now())

  @@map("audit_trail")
}

// Modèles IA (Agent Fiscal & Conseiller)
model TaxRule {
  id                   String   @id @default(uuid())
  tenant_id            String
  pays                 String
  taux_standard_tva    Decimal  @db.Decimal(5, 2)
  cotisations_sociales Json?
  date_verification    DateTime @default(now())
  source               String?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, pays])
  @@map("tax_rules")
}

model Conversation {
  id         String   @id @default(uuid())
  tenant_id  String
  titre      String?
  created_at DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  role            String // 'user' ou 'assistant'
  content         String   @db.Text
  created_at      DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

model CompanyMemory {
  id         String                      @id @default(uuid())
  tenant_id  String
  content    String
  type_info  String // ex: 'comportement', 'règle métier', 'historique'
  embedding  Unsupported("vector(768)")?
  created_at DateTime                    @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("company_memories")
}

// ============================================================
// MODULES MÉTIER (docgen, workflows, validations, intégrations, RH)
// Ces tables rendent les pages « Génération de documents »,
// « Workflows », « Sécurité », « Équipe » et « Réglages »
// réellement persistantes au lieu d'être des écrans vides.
// ============================================================

/// Gabarit métier réutilisable. `corps` contient des balises {{cle}}
/// remplacées à la génération par les données de `DocumentGenere.donnees`.
model DocumentTemplate {
  id          String   @id @default(uuid())
  tenant_id   String
  nom         String
  type        String   @default("autre") // facture | devis | bon_commande | releve | contrat | autre
  description String?
  corps       String   @default("")
  champs      Json     @default("[]") // [{ cle, label, type: texte|nombre|date|select }]
  actif       Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  documents DocumentGenere[]

  @@index([tenant_id])
  @@map("document_templates")
}

/// Document effectivement produit depuis un gabarit.
model DocumentGenere {
  id             String   @id @default(uuid())
  tenant_id      String
  template_id    String?
  document_id    String? // ligne documents (binaire MinIO)
  numero         String
  type           String   @default("autre")
  client_id      String?
  fournisseur_id String?
  destinataire   String?
  montant        Decimal? @db.Decimal(12, 2)
  statut         String   @default("brouillon") // brouillon | genere | valide | envoye
  donnees        Json     @default("{}")
  fichier        String?
  created_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  template DocumentTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  document Document?         @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@map("documents_generes")
}

/// Automatisation déclarative : conditions sur les données métier → actions.
model Workflow {
  id                 String    @id @default(uuid())
  tenant_id          String
  nom                String
  description        String?
  declencheur        String    @default("manuel") // evenement | planifie | manuel
  evenement          String? // facture_impayee | paiement_non_lie | document_a_risque | echeance_proche
  frequence          String? // daily | weekly | manuel
  conditions         Json      @default("[]") // [{ champ, operateur, valeur }]
  actions            Json      @default("[]") // [{ type, ... }]
  actif              Boolean   @default(true)
  derniere_execution DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  tenant     Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([tenant_id])
  @@map("workflows")
}

/// Trace d'une exécution de workflow (succès / échec / ignoré).
model WorkflowExecution {
  id          String    @id @default(uuid())
  tenant_id   String
  workflow_id String
  statut      String    @default("succes") // succes | echec | ignore
  declencheur String?
  cible       String?
  resultat    Json      @default("{}")
  erreur      String?
  debut       DateTime  @default(now())
  fin         DateTime?

  workflow Workflow @relation(fields: [workflow_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([workflow_id])
  @@map("workflow_executions")
}

/// File de validation humaine (page « Sécurité »).
model Validation {
  id         String    @id @default(uuid())
  tenant_id  String
  type       String // facture | depense | document | workflow | ecriture
  titre      String
  detail     String?
  cible_type String?
  cible_id   String?
  montant    Decimal?  @db.Decimal(12, 2)
  donnees    Json      @default("{}")
  statut     String    @default("en_attente") // en_attente | approuvee | rejetee
  decide_par String?
  decide_at  DateTime?
  motif      String?
  created_at DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, statut])
  @@map("validations")
}

/// Connecteur sortant (webhook, e-mail, ERP…). `statut` reflète le
/// résultat du dernier dispatch réellement effectué.
model Integration {
  id             String    @id @default(uuid())
  tenant_id      String
  nom            String
  type           String    @default("webhook") // webhook | email | erp | banque
  url            String?
  secret         String?
  evenements     Json      @default("[]")
  actif          Boolean   @default(false)
  statut         String    @default("inactif") // actif | erreur | inactif
  dernier_appel  DateTime?
  dernier_statut Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("integrations")
}

/// Salarié suivi par le module RH (distinct de `User`, qui est un compte
/// d'accès à la plateforme).
model Employe {
  id            String    @id @default(uuid())
  tenant_id     String
  user_id       String?
  nom           String
  email         String?
  telephone     String?
  fonction      String?
  departement   String?
  type_contrat  String?
  salaire_base  Decimal?  @db.Decimal(12, 2)
  date_embauche DateTime?
  statut        String    @default("actif") // actif | conge | sorti
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@map("employes")
}

// ─── Pré-lancement marketing ───────────────────────────────────────────────
// Ces deux tables n'appartiennent à aucun tenant : un visiteur des formulaires
// publics n'a encore ni compte ni entreprise. La position dans la file n'est
// pas stockée : elle se recalcule à la lecture pour rester fidèle à l'état
// réel (rang d'arrivée + boost de parrainage).

/// Une inscription à la liste d'attente. `code_parrain` est généré côté
/// serveur (crypto, jamais `Math.random`) : le lien de partage en dépend.
model ListeAttente {
  id           String    @id @default(uuid())
  prenom       String
  email        String    @unique // normalisé en minuscules avant écriture
  entreprise   String?
  code_parrain String    @unique
  parrain_id   String? // NULL quand le code transmis n'existe pas
  created_at   DateTime  @default(now())

  parrain ListeAttente?  @relation("Parrainage", fields: [parrain_id], references: [id], onDelete: SetNull)
  invites ListeAttente[] @relation("Parrainage")

  @@index([parrain_id])
  @@map("liste_attente")
}

/// Une demande de démonstration déposée depuis la landing.
model DemandeDemo {
  id         String   @id @default(uuid())
  prenom     String
  nom        String
  email      String
  telephone  String
  entreprise String
  formule    String // l'un des libellés exacts du sélecteur du formulaire
  message    String?
  created_at DateTime @default(now())

  @@map("demandes_demo")
}
