DATABASE_URL=postgres://elara:password@localhost:5432/elara
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KEYCLOAK_URL=http://localhost:8080
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
API_AI_INTERNAL_URL=http://localhost:8000

# --- Stockage des documents ---
# Mode : filesystem (recommandé local/on-premise, allège la BDD) | minio | auto
STORAGE_MODE=filesystem
# Répertoire de réception des documents (système de fichiers), monté en volume Docker
DOCUMENTS_DIR=./local-ged
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=elara-documents
