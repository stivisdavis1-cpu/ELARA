# --- Configuration Global ---
DATABASE_URL=postgresql://elara:password@localhost:5432/elara
REDIS_URL=redis://localhost:6379

# --- Routage Cloud LLM (failover Groq -> Together AI) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-specdec
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
CLOUD_TIMEOUT_PRIMARY=5
CLOUD_TIMEOUT_SECONDARY=10

# --- Repli local Ollama (On-Premise / hors-ligne) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
OLLAMA_TIMEOUT=60
EMBEDDING_TIMEOUT=30

# --- RabbitMQ (worker shadow processing) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Stockage des documents ---
# Répertoire partagé (système de fichiers) où api-nest a reçu les documents
# (mode filesystem). Doit correspondre à DOCUMENTS_DIR d'api-nest et être
# monté en volume Docker partagé. Allège la base de données.
DOCUMENTS_DIR=./local-ged

# --- MinIO (téléchargement des documents pour le worker shadow, si STORAGE_MODE=minio) ---
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=elara-documents